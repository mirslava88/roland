{
  "name": "presentation-display-manager",
  "version": "1.1.4",
  "author": "Roland",
  "license": "MIT",
  "private": true,
  "description": "Cross-platform app for seamless switching between presentations, videos, and PDFs on a secondary display",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "package:win": "electron-vite build && electron-builder --win",
    "package:mac": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "@hyzyla/pdfium": "^2.1.13",
    "pdfjs-dist": "^6.2.108",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/fuses": "^2.1.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.roland.presentation-display-manager",
    "productName": "Presentation Display Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "pdm-launcher-v1.ico"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "node_modules/@hyzyla/pdfium/LICENSE.md",
        "to": "licenses/hyzyla-pdfium-LICENSE.md"
      }
    ],
    "afterPack": "./build/afterPack.js",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Presentation Display Manager"
    },
    "forceCodeSigning": false,
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
