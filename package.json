{
  "name": "presentation-display-manager",
  "version": "1.1.5-stream",
  "author": "Roland",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "description": "Cross-platform app for seamless switching between presentations, videos, and PDFs on a secondary display",
  "main": "./out/main/index.js",
  "scripts": {
    "test:streaming": "node scripts/test-streaming.mjs && node scripts/test-streaming-handshake.mjs && node scripts/test-streaming-keyframes.mjs",
    "test:streaming:capture": "node scripts/run-streaming-capture-test.mjs",
    "test:streaming:latency": "node scripts/run-streaming-latency-test.mjs",
    "clean:out": "node scripts/clean-build-output.mjs",
    "clean:package": "node scripts/clean-build-output.mjs --package",
    "prebuild": "npm run clean:out",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:standard": "node scripts/build-edition.mjs standard",
    "build:stream": "node scripts/build-edition.mjs stream",
    "package": "npm run package:stream",
    "package:win": "npm run package:stream",
    "package:standard": "node scripts/build-edition.mjs standard package win",
    "package:stream": "node scripts/build-edition.mjs stream package win",
    "package:mac": "node scripts/build-edition.mjs standard package mac"
  },
  "dependencies": {
    "@hyzyla/pdfium": "^2.1.13",
    "pdfjs-dist": "^6.3.289",
    "qr-code-styling": "^1.9.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "ffmpeg-static": "^5.3.0",
    "postcss": "^8.5.27",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.roland.presentation-display-manager",
    "productName": "Presentation Display Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!out/main/streaming-smoke.cjs",
      "!out/main/streaming-latency.cjs",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg",
          "ffmpeg.exe",
          "ffmpeg*.LICENSE",
          "ffmpeg*.README",
          "LICENSE"
        ]
      },
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "*.ps1",
          "*.scpt",
          "!_test-*.ps1"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "pdm-launcher-v1.ico"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "node_modules/@hyzyla/pdfium/LICENSE.md",
        "to": "licenses/hyzyla-pdfium-LICENSE.md"
      },
      {
        "from": "node_modules/pdfjs-dist/LICENSE",
        "to": "licenses/pdfjs-dist-LICENSE.txt"
      },
      {
        "from": "node_modules/react/LICENSE",
        "to": "licenses/react-LICENSE.txt"
      },
      {
        "from": "node_modules/react-dom/LICENSE",
        "to": "licenses/react-dom-LICENSE.txt"
      },
      {
        "from": "node_modules/scheduler/LICENSE",
        "to": "licenses/scheduler-LICENSE.txt"
      },
      {
        "from": "node_modules/zustand/LICENSE",
        "to": "licenses/zustand-LICENSE.txt"
      },
      {
        "from": "node_modules/qr-code-styling/LICENSE",
        "to": "licenses/qr-code-styling-LICENSE.txt"
      }
    ],
    "afterPack": "./build/afterPack.js",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Presentation Display Manager"
    },
    "forceCodeSigning": false,
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
